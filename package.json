{
  "name": "@dsh-external/dsh-client-connection-authz",
  "description": "Auth-capable drop-in replacement for the DeepSeek Harness web connection",
  "version": "0.1.1-rc.2-authz.3",
  "private": true,
  "type": "module",
  "main": "lib/host/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/host/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf lib coverage",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:host": "tsc -p tsconfig.host.build.json",
    "build:client": "tsc -p tsconfig.client.build.json && node scripts/build-client.mjs",
    "build": "pnpm run clean && pnpm run build:host && pnpm run build:client",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@10.15.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sperictao/dsh-client-connection-authz.git"
  },
  "dependencies": {
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
